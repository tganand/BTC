# GEMINI_API_KEY: Optional Gemini API key if AI assistance is enabled.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Telegram Bot API Configuration
# Get token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Your personal or channel chat ID (e.g. from @userinfobot)
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Monitoring Configuration
TARGET_URL="https://rollielevel.com/BTC/predictor/"
POLL_INTERVAL_MS="1000"
CONFIRMATION_SECONDS="5"
MIN_CONFIDENCE="100"
SIGNAL_DIRECTION="UP" # "UP", "DOWN", or "BOTH"

# Security: Set a password to protect settings and test actions from unauthorized web visitors
DASHBOARD_PIN="1234"
